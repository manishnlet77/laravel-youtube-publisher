{
    "name": "manishnlet77/laravel-youtube-publisher",
    "description": "A production-ready Laravel package for authenticated YouTube publishing (Video & Shorts) via Google OAuth 2.0.",
    "keywords": [
        "laravel",
        "youtube",
        "youtube-api",
        "youtube-data-api",
        "video-upload",
        "shorts",
        "laravel-youtube-publisher",
        "oauth2"
    ],
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "Manish Saini",
            "email": "ms44587@gmail.com",
            "role": "Developer"
        }
    ],
    "require": {
        "php": "^8.1",
        "illuminate/support": "^10.0|^11.0|^12.0",
        "illuminate/console": "^10.0|^11.0|^12.0",
        "illuminate/http": "^10.0|^11.0|^12.0",
        "illuminate/database": "^10.0|^11.0|^12.0"
    },
    "require-dev": {
        "orchestra/testbench": "^8.0|^9.0",
        "phpunit/phpunit": "^10.0"
    },
    "autoload": {
        "psr-4": {
            "Manishnlet77\\YouTubePublisher\\": "src/",
            "Manishnlet77\\YouTubePublisher\\Database\\Factories\\": "database/factories/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Manishnlet77\\YouTubePublisher\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Manishnlet77\\YouTubePublisher\\YouTubePublisherServiceProvider"
            ],
            "aliases": {
                "YouTubePublisher": "Manishnlet77\\YouTubePublisher\\Facades\\YouTubePublisher"
            }
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
